# Example nginx site for api.selorg.com
# Dashboard login needs /api/v1/finance/auth/login (and other /api/v1/* routes).
# Prefer same-origin dashboard proxy (deploy/nginx-dashboard.selorg.com.conf.example) to avoid CORS.
# When the Node upstream is down, nginx 502 responses lack CORS unless added here (see map below).

upstream selorg_backend {
    server 127.0.0.1:3333;
    keepalive 32;
}

# Reflect allowed browser origins on preflight and on 5xx when Node is unreachable
map $http_origin $cors_allow_origin {
    default "";
    "~^https://([a-z0-9-]+\.)*selorg\.com(:\d+)?/?$" $http_origin;
}

server {
    listen 80;
    server_name api.selorg.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name api.selorg.com;

    # ssl_certificate /etc/letsencrypt/live/api.selorg.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/api.selorg.com/privkey.pem;

    client_max_body_size 20m;

    # Do not serve a static "API Server Running" page here — use Node readiness so dashboards
    # can detect a dead upstream before login (see authApi assertApiReachable).
    location = /health {
        proxy_pass http://selorg_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health/ready {
        proxy_pass http://selorg_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # All REST APIs (admin, darkstore, customer, logistics, …)
    location /api/ {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin $cors_allow_origin always;
            add_header Access-Control-Allow-Credentials true always;
            add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-Request-ID, X-Store-Id, X-Site-Id, Idempotency-Key, Accept, Origin" always;
            add_header Access-Control-Max-Age 86400 always;
            add_header Vary Origin always;
            add_header Content-Length 0;
            return 204;
        }

        add_header Access-Control-Allow-Origin $cors_allow_origin always;
        add_header Access-Control-Allow-Credentials true always;
        add_header Vary Origin always;

        proxy_pass http://selorg_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Long-running admin imports (Content Hub) now return 202 quickly and poll.
        # Keep elevated timeouts as a temporary safeguard for other sync uploads.
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_intercept_errors on;
        error_page 502 503 504 = @api_upstream_error;
    }

    location @api_upstream_error {
        add_header Access-Control-Allow-Origin $cors_allow_origin always;
        add_header Access-Control-Allow-Credentials true always;
        add_header Vary Origin always;
        default_type application/json;
        return 502 '{"success":false,"message":"API backend unreachable. Start Node on port 3333 (pm2 start selorg-backend)."}';
    }

    # Socket.IO (dashboard / HHD / rider — adjust paths to match your deployment)
    location /socket.io/ {
        proxy_pass http://selorg_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /hhd-socket.io/ {
        proxy_pass http://selorg_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    location /ws {
        proxy_pass http://selorg_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
}
