# Selorg Backend — environment template
# Copy to `.env` for local development, or `.env.production` for production.
# Never commit real secrets. Never put private keys in frontend envs.

# --------------------------------------------------
# Core
# --------------------------------------------------
NODE_ENV=development
PORT=3333
MONGO_URI=
JWT_SECRET=
CUSTOMER_JWT_SECRET=
ALLOWED_ORIGINS=

# --------------------------------------------------
# Browser Web Push (VAPID)
# --------------------------------------------------
# Generate: npx web-push generate-vapid-keys
# WEB_PUSH_CONTACT_EMAIL is only a VAPID contact identity (mailto URI).
# Frontend fetches ONLY the public key via GET /notifications/vapid-public-key
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=mailto:admin@selorg.com

# --------------------------------------------------
# Firebase Admin (FCM) — required for native FCM push
# --------------------------------------------------
# From Firebase Console → Project settings → Service accounts → Generate new private key.
# Put values in backend `.env` only. Do NOT commit the JSON file or real keys.
#
# FIREBASE_PRIVATE_KEY must keep \n escapes and be wrapped in double quotes:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional alternative (still env-only): entire service-account JSON as one line
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --------------------------------------------------
# Customer transactional email (orders / notifications)
# Shares the picker email stack (Resend / Brevo / SES / SendGrid / SMTP).
# OTP / login does NOT consult notificationPreferences.
# --------------------------------------------------
# EMAIL_HOST=
# EMAIL_PORT=465
# EMAIL_USER=
# EMAIL_PASS=
# ADMIN_EMAIL_FROM="Selorg Admin <admin@selorg.com>"
# RESEND_API_KEY=
# RESEND_FROM=
# RESEND_VERIFIED_FROM=
# PICKER_EMAIL_PROVIDER=resend
# CUSTOMER_APP_NAME=Selorg
# CUSTOMER_EMAIL_FROM="Selorg <admin@selorg.com>"
# CUSTOMER_RESEND_FROM="Selorg <admin@selorg.com>"
# CUSTOMER_RESEND_VERIFIED_FROM="Selorg <otp@verified-domain.com>"
#
# LOCAL TEST OVERRIDES — never set in production AWS.
# In production these are ignored unless ALLOW_CUSTOMER_NOTIF_OVERRIDES=true.
# CUSTOMER_NOTIF_EMAIL_TO=admin@selorg.com
# CUSTOMER_NOTIF_SMS_TO=
# CUSTOMER_NOTIF_WHATSAPP_TO=
# ALLOW_CUSTOMER_NOTIF_OVERRIDES=false
