# Selorg Backend — environment template
# Copy to `.env` for local development, or `.env.production` for production.
# Never commit real secrets. Never put private keys in frontend envs.

# --------------------------------------------------
# Core
# --------------------------------------------------
NODE_ENV=development
PORT=3333
MONGO_URI=
JWT_SECRET=
CUSTOMER_JWT_SECRET=
ALLOWED_ORIGINS=

# --------------------------------------------------
# Browser Web Push (VAPID)
# --------------------------------------------------
# Generate: npx web-push generate-vapid-keys
# WEB_PUSH_CONTACT_EMAIL is only a VAPID contact identity (mailto URI).
# Frontend fetches ONLY the public key via GET /notifications/vapid-public-key
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=mailto:admin@selorg.com

# --------------------------------------------------
# Firebase Admin (FCM) — required for native FCM push
# --------------------------------------------------
# From Firebase Console → Project settings → Service accounts → Generate new private key.
# Put values in backend `.env` only. Do NOT commit the JSON file or real keys.
#
# FIREBASE_PRIVATE_KEY must keep \n escapes and be wrapped in double quotes:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional alternative (still env-only): entire service-account JSON as one line
# FIREBASE_SERVICE_ACCOUNT_JSON=
